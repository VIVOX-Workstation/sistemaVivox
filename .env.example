# Banco de dados
DATABASE_URL="postgresql://vivox:vivox@postgres:5432/vivox?schema=public"

# Redis (cache + filas)
REDIS_HOST=redis
REDIS_PORT=6379

# Storage local (MinIO, compatível com API S3)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=vivox
S3_SECRET_KEY=vivox12345
S3_BUCKET=vivox-media
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/vivox-media # Em produção usar a CDN ou URL real do bucket

# App & Auth
PORT=3000
JWT_SECRET=troque-por-um-segredo-forte

# Token exigido pelo endpoint público POST /auth/seed-admin para provisionar
# o primeiro admin. Sem este valor definido, o endpoint recusa qualquer chamada.
# defina um valor forte para habilitar o endpoint de setup
SETUP_TOKEN=

# Origens permitidas para CORS, separadas por vírgula (ex:
# "http://localhost:5173,https://app.vivox.com.br"). Se não definida, usa
# apenas http://localhost:5173 (porta padrão do Vite em dev).
CORS_ORIGINS=

# IA & Provedores
GROQ_API_KEY=
TAVILY_API_KEY=

# Google Cloud Service Account (Google Analytics 4 & Search Console APIs)
# Opção A: Variáveis individuais
GOOGLE_CLIENT_EMAIL="sua-service-account@seu-projeto.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_PROJECT_ID="seu-projeto-id"

# Opção B: JSON bruto da Service Account (alternativa)
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "..."}'

# Opção C: Caminho do arquivo JSON baixado do Google Cloud Console (alternativa)
# GOOGLE_APPLICATION_CREDENTIALS="credentials.json"
