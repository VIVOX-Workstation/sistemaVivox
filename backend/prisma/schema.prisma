generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x", "windows"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// --- ENUMS COMPARTILHADOS ---

enum StatusCliente {
  ATIVO
  PAUSADO
  ENCERRADO
  PROSPECT
}

enum TipoServico {
  GERENCIAMENTO_REDES
  FOLDER
  REVISTA
  LANDING_PAGE
  APP
  FOTOGRAFIA
  VIDEO
  TRAFEGO_PAGO
  IDENTIDADE_VISUAL
}

enum StatusServico {
  ATIVO
  CONCLUIDO
  PAUSADO
  CANCELADO
}

enum TipoProducao {
  POST
  VIDEO
  FOLDER
  REVISTA
  LANDING_PAGE
  APP
  FOTO
}

enum StatusProducao {
  EM_PRODUCAO
  EM_REVISAO
  APROVADO
  PUBLICADO
}

enum StatusHospedagem {
  ATIVO
  PENDENTE_RENOVACAO
  MANUTENCAO
  EXPIRADO
  CANCELADO
}

enum CicloRenovacao {
  MENSAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
  BIENAL
}

enum OrigemDado {
  REPORTEI
  MANUAL
}

enum TipoPublicacao {
  POST
  REELS
  CARROSSEL
  STORY
  VIDEO
}

enum StatusOportunidade {
  ABERTA
  APRESENTADA
  ACEITA
  RECUSADA
}

enum StatusReuniao {
  AGENDADA
  REALIZADA
  CANCELADA
}

enum StatusPlanejamento {
  BRIEFING
  PLANEJAMENTO
  EM_PRODUCAO
  EM_REVISAO
  CONCLUIDO
}

enum StatusEscopoItem {
  PLANEJADO
  EM_DESENVOLVIMENTO
  CONCLUIDO
}

enum StatusMarco {
  PENDENTE
  CONCLUIDO
  ATRASADO
}

enum TipoReferencia {
  LINK
  ARQUIVO
  IMAGEM
}

enum TipoEventoHistorico {
  CRIACAO
  ESCOPO_ALTERADO
  PRAZO_ALTERADO
  STATUS_ALTERADO
  MARCO_CONCLUIDO
  RESPONSAVEL_ALTERADO
  RENOVACAO
  PAUSA
  CANCELAMENTO
  NOTA_MANUAL
}

// --- MODELOS ---

model User {
  id    String @id @default(uuid())
  nome  String
  email String @unique
  senha String

  // Relações
  clientes              Cliente[]             @relation("ResponsavelInterno")
  producoes             Producao[]            @relation("ProdutorResponsavel")
  historicoAcoes        ServicoHistorico[]
  reunioes              Reuniao[]             @relation("ReuniaoParticipantes")
  planejamentos         PlanejamentoServico[] @relation("PlanejamentoResponsaveis")
  historicoPlanejamento HistoricoServico[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// MÓDULO: VIVOX CLIENTES
// ============================================

model Cliente {
  id                 String        @id @default(uuid())
  nomeFantasia       String
  razaoSocial        String?
  cnpjCpf            String
  segmento           String
  responsavelId      String?
  responsavel        User?         @relation("ResponsavelInterno", fields: [responsavelId], references: [id])
  contatos           Json // [{ nome, cargo, telefone, email, whatsapp }]
  status             StatusCliente
  dataInicioContrato DateTime?
  dataFimContrato    DateTime?
  logoUrl            String?
  observacoes        String?
  ga4PropertyId      String?
  gscSiteUrl         String?

  // Relações Clientes
  servicosContratados ServicoContratado[]
  producoes           Producao[]
  midias              MidiaCliente[]
  ativosHospedagem    AtivoHospedagem[]

  // Relações Analytics
  analyticsSnapshots AnalyticsSnapshot[]
  publicacoes        Publicacao[]
  avaliacoesGmb      AvaliacaoGmb[]
  oportunidades      Oportunidade[]
  reunioes           Reuniao[]
  fontesContexto     FonteContexto[]
  documentosVetoriais DocumentoVetorial[]
  inteligenciasMercado InteligenciaMercado[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FonteContexto {
  id        String   @id @default(uuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  titulo    String
  descricao String?  @db.Text
  tipo      String   @default("TEXTO") // LINK, ARQUIVO, TEXTO
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentoVetorial {
  id        String   @id @default(uuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  conteudo  String   @db.Text
  tipo      String   @default("TEXTO") // TEXTO, LINK, ARQUIVO, TENDENCIA_SEMANA
  titulo    String?
  vetor     Unsupported("vector(1536)")?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clienteId]) // B-Tree index para isolamento de tenant
}

model InteligenciaMercado {
  id         String   @id @default(uuid())
  clienteId  String
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  resumo     String   @db.Text
  tendencias Json     // Array de tendências estruturadas: { titulo, descricao, impacto }
  fontes     Json     // URLs usadas como base pela Tavily: [{ title, url }]
  data       DateTime @default(now())
}

model ServicoContratado {
  id              String               @id @default(uuid())
  clienteId       String
  cliente         Cliente              @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipoServico     TipoServico
  status          StatusServico
  dataContratacao DateTime
  dataEntrega     DateTime?
  valor           Decimal?
  descricaoEscopo String?
  historico       ServicoHistorico[]
  producoes       Producao[]
  planejamento    PlanejamentoServico?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServicoHistorico {
  id        String            @id @default(uuid())
  servicoId String
  servico   ServicoContratado @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   User              @relation(fields: [usuarioId], references: [id])
  acao      String

  createdAt DateTime @default(now())
}

model Producao {
  id            String             @id @default(uuid())
  clienteId     String
  cliente       Cliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  servicoId     String?
  servico       ServicoContratado? @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  tipo          TipoProducao
  arquivoUrl    String?
  dataProducao  DateTime?
  responsavelId String?
  responsavel   User?              @relation("ProdutorResponsavel", fields: [responsavelId], references: [id])
  status        StatusProducao

  // Analytics linkage
  publicacoes Publicacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MidiaCliente {
  id         String   @id @default(uuid())
  clienteId  String
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  url        String
  tags       String[]
  dataUpload DateTime @default(now())
}

// ============================================
// MÓDULO: VIVOX ANALYTICS
// ============================================

model AnalyticsSnapshot {
  id                   String     @id @default(uuid())
  clienteId            String
  cliente              Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  periodoInicio        DateTime
  periodoFim           DateTime
  origem               OrigemDado
  alcanceTotal         Int?
  engajamentoTotal     Int?
  notaGmb              Float?
  avaliacoesGmbPeriodo Int?

  createdAt DateTime @default(now())
}

model Publicacao {
  id                String         @id @default(uuid())
  clienteId         String
  cliente           Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  producaoId        String?
  producao          Producao?      @relation(fields: [producaoId], references: [id], onDelete: SetNull)
  tipo              TipoPublicacao
  dataPublicacao    DateTime
  alcance           Int?
  curtidas          Int?
  comentarios       Int?
  compartilhamentos Int?
  origemDado        OrigemDado

  createdAt DateTime @default(now())
}

model AvaliacaoGmb {
  id           String    @id @default(uuid())
  clienteId    String
  cliente      Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nota         Int
  comentario   String?
  data         DateTime
  respondida   Boolean   @default(false)
  dataResposta DateTime?

  createdAt DateTime @default(now())
}

model Oportunidade {
  id              String             @id @default(uuid())
  clienteId       String
  cliente         Cliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  servicoSugerido TipoServico
  justificativa   String?
  status          StatusOportunidade @default(ABERTA)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reuniao {
  id        String   @id @default(uuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  dataHora  DateTime

  // Participantes vinculados ao User
  participantes User[] @relation("ReuniaoParticipantes")

  resumo String?
  status StatusReuniao @default(AGENDADA)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// MÓDULO: PLANEJAMENTO SERVIÇO
// ============================================

model PlanejamentoServico {
  id                  String             @id @default(uuid())
  servicoContratadoId String             @unique
  servicoContratado   ServicoContratado  @relation(fields: [servicoContratadoId], references: [id], onDelete: Cascade)
  ideiaBriefing       String?            @db.Text
  statusGeral         StatusPlanejamento @default(BRIEFING)
  prazoEntrega        DateTime?
  flowNodes           Json?
  flowEdges           Json?

  // Relações
  responsaveis User[]              @relation("PlanejamentoResponsaveis")
  escopoItens  EscopoItem[]
  marcos       Marco[]
  referencias  ReferenciaServico[]
  historico    HistoricoServico[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EscopoItem {
  id                    String              @id @default(uuid())
  planejamentoServicoId String
  planejamentoServico   PlanejamentoServico @relation(fields: [planejamentoServicoId], references: [id], onDelete: Cascade)
  titulo                String
  descricao             String?             @db.Text
  status                StatusEscopoItem    @default(PLANEJADO)
  ordem                 Int                 @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Marco {
  id                    String              @id @default(uuid())
  planejamentoServicoId String
  planejamentoServico   PlanejamentoServico @relation(fields: [planejamentoServicoId], references: [id], onDelete: Cascade)
  titulo                String
  dataInicio            DateTime?
  dataPrevista          DateTime
  dataRealizada         DateTime?
  status                StatusMarco         @default(PENDENTE)
  dependeDeId           String?
  dependeDe             Marco?              @relation("MarcoDependencia", fields: [dependeDeId], references: [id], onDelete: SetNull)
  dependentes           Marco[]             @relation("MarcoDependencia")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReferenciaServico {
  id                    String              @id @default(uuid())
  planejamentoServicoId String
  planejamentoServico   PlanejamentoServico @relation(fields: [planejamentoServicoId], references: [id], onDelete: Cascade)
  tipo                  TipoReferencia
  urlOuArquivo          String
  descricao             String?             @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HistoricoServico {
  id                    String              @id @default(uuid())
  planejamentoServicoId String
  planejamentoServico   PlanejamentoServico @relation(fields: [planejamentoServicoId], references: [id], onDelete: Cascade)
  tipoEvento            TipoEventoHistorico
  descricao             String              @db.Text
  autorId               String
  autor                 User                @relation(fields: [autorId], references: [id])
  data                  DateTime            @default(now())
  valorAnterior         String?             @db.Text
  valorNovo             String?             @db.Text
}

// ============================================
// MÓDULO: ATIVOS DIGITAIS & HOSPEDAGEM (VPS / LPs / SITES)
// ============================================

model AtivoHospedagem {
  id                   String           @id @default(uuid())
  clienteId            String
  cliente              Cliente          @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  
  titulo               String           // ex: "LP Implante Capilar", "Site Institucional"
  url                  String           // ex: "https://drcliente.com.br/capilar"
  
  // Dados de Servidor / VPS
  provedorVps          String?          // ex: "VPS Vivox Hetzner #1", "Hostinger", "Coolify"
  ipServidor           String?          // ex: "179.198.120.113"
  dataRenovacaoVps     DateTime?        // Próximo vencimento da VPS/Hospedagem
  cicloVps             CicloRenovacao   @default(ANUAL)
  custoVps             Decimal?         // Custo que a Vivox paga (opcional)
  valorCobrado         Decimal?         // Valor que a Vivox cobra do cliente
  
  // Dados de Domínio & DNS
  dominio              String?          // ex: "drcliente.com.br"
  registradorDominio   String?          // ex: "Registro.br", "GoDaddy", "Cloudflare"
  dataExpiracaoDominio DateTime?        // Data que expira o domínio no registrador
  dnsProvedor          String?          // ex: "Cloudflare", "Registro.br"
  
  // Status & Notas
  status               StatusHospedagem @default(ATIVO)
  sslAtivo             Boolean          @default(true)
  observacoes          String?          @db.Text
  
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([clienteId])
}

